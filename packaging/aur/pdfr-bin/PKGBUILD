# Maintainer: Rasmus Kjellberg <2277443+kjellberg@users.noreply.github.com>
# The prebuilt release binaries: installs in seconds, no Rust needed.
# The release workflow updates pkgver and sha256sums and pushes to the AUR.
pkgname=pdfr-bin
pkgver=0.4.0
pkgrel=1
pkgdesc="Fill in PDF forms the way they were meant to be filled in (prebuilt)"
arch=('x86_64' 'aarch64')
url="https://github.com/kjellberg/pdfr"
license=('LicenseRef-PolyForm-Strict-1.0.0')
depends=('gcc-libs' 'glibc' 'libglvnd' 'libxkbcommon' 'libxkbcommon-x11'
         'libx11' 'libxcursor' 'libxrandr' 'libxi' 'hicolor-icon-theme')
optdepends=('claude-code: AI recognition of unusual field labels'
            'xdg-desktop-portal: native file and print dialogs')
provides=('pdfr')
conflicts=('pdfr')
options=('!strip' '!debug')
source_x86_64=("$url/releases/download/v$pkgver/pdfr-v$pkgver-x86_64-linux.tar.gz")
source_aarch64=("$url/releases/download/v$pkgver/pdfr-v$pkgver-aarch64-linux.tar.gz")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  cd "pdfr-v$pkgver-$CARCH-linux"
  ./install.sh "$pkgdir" /usr
}
