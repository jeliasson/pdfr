# Maintainer: Rasmus Kjellberg <2277443+kjellberg@users.noreply.github.com>
# Builds pdfr from source. For the prebuilt package see ../pdfr-bin.
# The release workflow updates pkgver and sha256sums and pushes to the AUR.
pkgname=pdfr
pkgver=0.2.0
pkgrel=1
pkgdesc="Fill in PDF forms the way they were meant to be filled in"
arch=('x86_64' 'aarch64')
url="https://github.com/kjellberg/pdfr"
license=('LicenseRef-PolyForm-Strict-1.0.0')
# The GUI loads OpenGL/EGL, xkbcommon and (on X11) the X libraries at run time.
depends=('gcc-libs' 'glibc' 'libglvnd' 'libxkbcommon' 'libxkbcommon-x11'
         'libx11' 'libxcursor' 'libxrandr' 'libxi' 'hicolor-icon-theme')
makedepends=('cargo')
optdepends=('claude-code: AI recognition of unusual field labels'
            'xdg-desktop-portal: native file and print dialogs')
conflicts=('pdfr-bin')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p pdfr
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release -p pdfr-core -p pdfr-assist
}

package() {
  cd "$pkgname-$pkgver"
  packaging/linux/install.sh target/release/pdfr "$pkgdir" /usr
}
