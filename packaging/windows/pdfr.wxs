<?xml version="1.0" encoding="UTF-8"?>
<!--
  pdfr installer (WiX v5), per user: no administrator rights needed.
  Installs to %LOCALAPPDATA%\Programs\pdfr and adds:
    - a Start menu entry (also found by Start search)
    - "Open with" for PDF files, and pdfr in Settings > Default apps
    - the pdfr command on the user's PATH
  Built by build-msi.ps1. Untested on real Windows yet.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="pdfr" Manufacturer="Rasmus Kjellberg" Version="$(Version)"
           UpgradeCode="6B0F6E5C-3D0B-4D9E-9C55-7E2B1E0A4F21" Scope="perUser" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of pdfr is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="pdfr.ico" SourceFile="..\..\assets\icon\pdfr.ico" />
    <Property Id="ARPPRODUCTICON" Value="pdfr.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/kjellberg/pdfr" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLDIR" Name="pdfr" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <ComponentGroup Id="App" Directory="INSTALLDIR">
      <Component Id="Exe" Guid="*">
        <File Id="pdfr.exe" Source="$(BinDir)\pdfr.exe" />
        <RegistryValue Root="HKCU" Key="Software\pdfr" Name="InstallDir" Type="string" Value="[INSTALLDIR]" KeyPath="yes" />
        <RemoveFolder Id="RemoveInstallDir" On="uninstall" />
        <RemoveFolder Id="RemovePrograms" Directory="ProgramsDir" On="uninstall" />
      </Component>
      <Component Id="Licences" Guid="*">
        <File Source="..\..\LICENSE.md" />
        <File Source="..\..\assets\LICENSE-Inter.txt" />
        <File Source="..\..\assets\LICENSE-GreatVibes.txt" />
        <File Source="..\..\assets\THIRD-PARTY-NOTICES.txt" />
        <RegistryValue Root="HKCU" Key="Software\pdfr" Name="Licences" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="Path" Guid="*">
        <Environment Id="PATH" Name="PATH" Value="[INSTALLDIR]" Permanent="no" Part="last" Action="set" System="no" />
        <RegistryValue Root="HKCU" Key="Software\pdfr" Name="Path" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="Registration" Guid="*">
        <!-- ProgID: how pdfr opens a PDF. -->
        <RegistryValue Root="HKCU" Key="Software\Classes\pdfr.pdf" Value="PDF document" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Classes\pdfr.pdf\DefaultIcon" Value="&quot;[INSTALLDIR]pdfr.exe&quot;,0" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Classes\pdfr.pdf\shell\open\command" Value="&quot;[INSTALLDIR]pdfr.exe&quot; &quot;%1&quot;" Type="string" />
        <!-- "Open with" -->
        <RegistryValue Root="HKCU" Key="Software\Classes\.pdf\OpenWithProgids" Name="pdfr.pdf" Value="" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Classes\Applications\pdfr.exe" Name="FriendlyAppName" Value="pdfr" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Classes\Applications\pdfr.exe\SupportedTypes" Name=".pdf" Value="" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Classes\Applications\pdfr.exe\shell\open\command" Value="&quot;[INSTALLDIR]pdfr.exe&quot; &quot;%1&quot;" Type="string" />
        <!-- Settings > Default apps -->
        <RegistryValue Root="HKCU" Key="Software\pdfr\Capabilities" Name="ApplicationName" Value="pdfr" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\pdfr\Capabilities" Name="ApplicationDescription" Value="Fill in PDF forms the way they were meant to be filled in" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\pdfr\Capabilities\FileAssociations" Name=".pdf" Value="pdfr.pdf" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\RegisteredApplications" Name="pdfr" Value="Software\pdfr\Capabilities" Type="string" KeyPath="yes" />
      </Component>
      <Component Id="StartMenu" Guid="*">
        <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="pdfr"
                  Description="Fill in PDF forms" Target="[INSTALLDIR]pdfr.exe" WorkingDirectory="INSTALLDIR" Icon="pdfr.ico">
          <!-- Matches the window to the shortcut on the taskbar. -->
          <ShortcutProperty Key="System.AppUserModel.ID" Value="io.github.kjellberg.pdfr" />
        </Shortcut>
        <RegistryValue Root="HKCU" Key="Software\pdfr" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="pdfr">
      <ComponentGroupRef Id="App" />
    </Feature>
  </Package>
</Wix>
